# ============================================================================
# Environment Configuration - SQA Management System
# Production with Azure SQL Database
# ============================================================================

# DATABASE - AZURE SQL
DATABASE_TYPE=sqlserver
MSSQL_SERVER=your-server.database.windows.net
MSSQL_DATABASE=sqa_management
MSSQL_USERNAME=adminuser
MSSQL_PASSWORD=${AZURE_SQL_PASSWORD}
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# For Azure SQL:
# 1. Use Entra ID authentication (recommended)
# 2. Set MSSQL_USERNAME to: user@domain.onmicrosoft.com
# 3. Add MSSQL_AUTH_METHOD=ActiveDirectoryPassword

# SECURITY
SECRET_KEY=${SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OPENAI / AZURE OPENAI
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o

# AZURE CONFIGURATION
AZURE_OPENAI_API_KEY=${AZURE_OPENAI_API_KEY}
AZURE_OPENAI_ENDPOINT=${AZURE_OPENAI_ENDPOINT}
AZURE_OPENAI_MODEL_NAME=gpt-4o

# APPLICATION
DEBUG=false
APP_NAME=SQA Management System
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# FRONTEND
FRONTEND_URL=https://your-frontend-domain.com

# CORS
CORS_ORIGINS=["https://your-frontend-domain.com"]

# EMAIL (optional)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}

# MONITORING (optional)
APPLICATION_INSIGHTS_KEY=${APPLICATION_INSIGHTS_KEY}

# CONNECTION STRING (alternative format)
# SQLALCHEMY_DATABASE_URL=mssql+pyodbc://${MSSQL_USERNAME}:${MSSQL_PASSWORD}@${MSSQL_SERVER}:1433/${MSSQL_DATABASE}?driver=ODBC+Driver+17+for+SQL+Server
