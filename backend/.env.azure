# Production Environment Variables for Azure Deployment
# SQA Management System Backend

# Frontend URL
FRONTEND_URL=https://sqa-fe.azurewebsites.net

# CORS Origins (comma-separated)
CORS_ORIGINS=https://sqa-fe.azurewebsites.net,http://localhost:5173,http://localhost:3000

# Security
DEBUG=False
SECRET_KEY=your-production-secret-key-change-this
JWT_SECRET_KEY=your-production-jwt-secret-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Azure SQL Database (will be set in Azure Portal App Settings)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=sqa_management
AZURE_SQL_USERNAME=your-username
AZURE_SQL_PASSWORD=your-password
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Azure OpenAI (will be set in Azure Portal App Settings)
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Application
APP_NAME=SQA Management System
