# ============================================================================
# Azure DevOps Variable Group Configuration Template
# Import this into Azure DevOps → Pipelines → Library → Variable Groups
# ============================================================================

# Variable Group Name: sqa-backend-vars
# Description: Backend configuration for SQA Management System

# Azure SQL Configuration
AZURE_SQL_SERVER=sqaidealabs.database.windows.net
AZURE_SQL_DATABASE=idealabs
AZURE_SQL_USERNAME=sqaadmin
AZURE_SQL_PASSWORD=admin@123  # Mark as SECRET in Azure DevOps
AZURE_SQL_DRIVER=ODBC Driver 17 for SQL Server

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production  # Mark as SECRET

# Environment
ENVIRONMENT=production

# ============================================================================
# INSTRUCTIONS FOR AZURE DEVOPS
# ============================================================================

# 1. Go to Azure DevOps → Project → Pipelines → Library
# 2. Click "+ Variable group"
# 3. Name: sqa-backend-vars
# 4. Description: Backend configuration for SQA Management System
# 5. Add each variable below
#
# 6. For PASSWORD and JWT_SECRET fields:
#    - Click the lock icon (🔒) to mark as SECRET
#    - This prevents the value from appearing in logs
#
# 7. Click "Save"

# ============================================================================
# VARIABLE BREAKDOWN
# ============================================================================

# AZURE_SQL_SERVER
#   - Azure SQL Server hostname
#   - Format: servername.database.windows.net
#   - Value: sqaidealabs.database.windows.net

# AZURE_SQL_DATABASE
#   - Database name on the SQL Server
#   - Value: idealabs

# AZURE_SQL_USERNAME
#   - Server admin login username
#   - Value: sqaadmin

# AZURE_SQL_PASSWORD ⚠️ SECRET
#   - Server admin login password
#   - Mark as SECRET (click lock icon)
#   - Value: admin@123

# AZURE_SQL_DRIVER
#   - ODBC driver for SQL Server
#   - Should match installed version (usually "ODBC Driver 17 for SQL Server")

# JWT_SECRET ⚠️ SECRET
#   - Secret key for JWT token signing
#   - Generate a strong random string in production
#   - Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   - Mark as SECRET

# ENVIRONMENT
#   - Deployment environment
#   - Values: development, staging, production
#   - Value: production

# ============================================================================
# USED IN PIPELINE
# ============================================================================

# These variables are referenced in azure-pipelines.yml:
#
# jobs:
#   - deployment: DeployBackend
#     steps:
#       - task: AzureAppServiceSettings@1
#         inputs:
#           appSettings: |
#             [
#               {
#                 "name": "AZURE_SQL_SERVER",
#                 "value": "$(AZURE_SQL_SERVER)",  # ← Variable reference
#                 "slotSetting": false
#               },
#               {
#                 "name": "AZURE_SQL_PASSWORD",
#                 "value": "$(AZURE_SQL_PASSWORD)",  # ← Secret variable
#                 "slotSetting": false
#               },
#               ...
#             ]

# ============================================================================
# HOW TO USE IN AZURE DEVOPS PIPELINE
# ============================================================================

# In your azure-pipelines.yml:
#
# variables:
#   - group: sqa-backend-vars  # ← Links to this variable group
#
# jobs:
#   - deployment: DeployBackend
#     steps:
#       - task: AzureAppServiceSettings@1
#         inputs:
#           appSettings: |
#             [
#               {
#                 "name": "AZURE_SQL_SERVER",
#                 "value": "$(AZURE_SQL_SERVER)",
#               },
#               {
#                 "name": "AZURE_SQL_PASSWORD",
#                 "value": "$(AZURE_SQL_PASSWORD)",
#               },
#               ...
#             ]

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================

# 1. ALWAYS mark passwords and secrets as SECRET
#    - This prevents them from appearing in pipeline logs
#    - Sensitive values are masked in output
#
# 2. Use different secrets for different environments
#    - Create separate variable groups: sqa-dev-vars, sqa-prod-vars
#    - Link to pipeline based on branch/environment
#
# 3. Rotate secrets periodically (every 90 days recommended)
#    - Update password in Azure SQL Server
#    - Update in DevOps variable group
#    - Restart web apps
#
# 4. Never commit secrets to source control
#    - Use .gitignore to exclude .env files
#    - Always use Azure DevOps secrets for sensitive data
#
# 5. Monitor access to variable groups
#    - Only authorized team members should see variables
#    - Audit who created/modified variables (in variable history)

# ============================================================================
# TESTING YOUR CONFIGURATION
# ============================================================================

# After setting up the variable group:
#
# 1. Create a test pipeline job:
#    - script: echo "AZURE_SQL_SERVER = $(AZURE_SQL_SERVER)"
#    - This will show the actual value (for non-secret variables)
#    - Secret variables will show *** in logs
#
# 2. Test the deployment:
#    - Run azure-pipelines.yml on main branch
#    - Check that web app is created successfully
#    - Verify application settings in Azure Portal
#
# 3. Verify database connection:
#    - Check backend logs in Azure Portal → Log stream
#    - Should show: "☁️ Using Azure SQL database (production)"
#    - Should show: "✅ Database connection established"

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# If variables are not being applied:
# 1. Ensure variable group is linked in pipeline
# 2. Check variable names match exactly (case-sensitive)
# 3. Verify secret variables are being passed correctly
# 4. Check Azure DevOps pipeline logs for variable values
#
# If deployment fails:
# 1. Check application settings in Azure Portal
# 2. Verify all variables are set correctly
# 3. Check backend logs for connection errors
# 4. Test SQL connection separately with SSMS

# ============================================================================
